{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "NovaWallet",
    "Audience": "NovaWallet.Api",
    "TokenHours": 24
  },
  "DevAuth": {
    "Enabled": false
  },
  "Transfers": {
    "DailyLimitKobo": 50000000
  },
  "Outbox": {
    "PollSeconds": 3
  },
  "RateLimiting": {
    "TransfersPerMinute": 60
  }
}
